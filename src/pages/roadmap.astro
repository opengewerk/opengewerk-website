---
import Page from '../layouts/Page.astro';
import Phases, { type Phase } from '../components/Phases.astro';
import { LINKS } from '../site';

const phases: Phase[] = [
  {
    number: '0',
    title: 'Fundament',
    state: 'done',
    result:
      'Datenmodell, Mandantentrennung in der Datenbank, Rollen und Rechte, Nummernkreise mit Festschreibung, Audit-Log mit Hashkette, Offline-Datenschicht, Regel-Engine, dazu Betrieb, Sicherung, Rückspielen und Update über Docker Compose. Seit Oktober 2026 liegt das Fundament in eigenen Paketen, auf denen auch OpenGewerk Haustechnik aufbaut.',
  },
  {
    number: '1',
    title: 'MVP für den Pilotbetrieb',
    state: 'active',
    result:
      'Am Ende arbeitet der Pilotbetrieb produktiv damit. Gebaut ist alles, was der Fahrplan dafür nennt: Anmeldung, Ersteinrichtung und Benutzerverwaltung, die Oberfläche von Kunde bis Auftrag samt Anlagenstruktur und Stromkreisverzeichnis, Angebot, Kostenvoranschlag und Auftragsbestätigung mit Belehrungen, der Regiebericht mit Unterschrift und eigenen Feldern, Abschlags- und Schlussrechnung mit Storno und die E-Rechnung als XRechnung und ZUGFeRD-PDF, dazu Zeiterfassung, Dokumentenablage, Aufgaben, der Versand per E-Mail, das Prüfprotokoll nach VDE 0100-600 und Releases mit signierten Abbildern. Erschienen sind die Fassungen 0.1.0 vom 24.09.2026 bis 0.5.0 vom 04.10.2026. Offen sind die fachkundige Abnahme der Regelpakete und Grenzwerte und ein Praxistest der E-Rechnung bei einem echten Empfänger.',
  },
  {
    number: '1b',
    title: 'Machbarkeitsnachweis Messgeräte',
    state: 'open',
    result:
      'Eine echte Exportdatei aus der PC-Software des Pilotbetriebs wird zu Messwerten an der Anlage. Ergebnis ist eine begründete Entscheidung über den Umfang des Messgeräte-Imports, ausdrücklich auch gegen ihn.',
  },
  {
    number: '2',
    title: 'Elektro- und PV-Kern',
    state: 'started',
    result:
      'Der fachliche Teil in der Breite: die übrigen Prüfprotokolle vom E-Check bis VDE-AR-N 4105, die Abnahme mit Gewährleistung und Mängeln, der Messgeräte-Import so weit, wie der Machbarkeitsnachweis ihn trägt, PV-Dokumentation, Wartungsverträge, Fristen für Wiederholungsprüfungen und das QR-Etikett. Dazu Plantafel, Serviceaufträge, Material und Fahrzeuglager, Personal und die Funktionen der DSGVO. Betrieb mit mehreren Monteuren. Mit 0.5.0 erschienen sind davon die Fristen-Engine, Push-Nachrichten auf die Geräte, das Änderungsprotokoll im Büro, Passkeys, Tags an Kunden und Objekten, der Zugang zum Objekt, die PV-Struktur mit dem Scanner für Seriennummern, das QR-Etikett je Anlage, Artikel und Lieferanten und mehrere Betriebe auf einer Instanz.',
  },
  {
    number: '3',
    title: 'Buchhaltung',
    state: 'planned',
    result:
      'Empfang von E-Rechnungen, Journal, offene Posten, Mahnwesen, Bank, EÜR und Umsatzsteuer-Voranmeldung, DATEV- und Lohnexport. Der Umstieg erfolgt erst nach einem bestandenen Parallelbetrieb neben der bisherigen Lösung. Ab hier kann der Kanzlei-Hub andocken.',
  },
  {
    number: '3b',
    title: 'Zusammenarbeit mit der Kanzlei',
    state: 'planned',
    result:
      'Der Monatsabschluss läuft ohne E-Mail und Telefon: Webhooks, Rückfragen am Beleg, Buchungsvorschläge zur Freigabe.',
  },
  {
    number: '4',
    title: 'Projekttiefe',
    state: 'planned',
    result:
      'Bautagebuch, Kalkulation und Nachkalkulation, Nachträge, Subunternehmer, Einkauf, Fuhrpark und Werkzeug, alles was ein Baustellenbetrieb über den einzelnen Auftrag hinaus braucht.',
  },
  {
    number: '5',
    title: 'Kundenportal',
    state: 'planned',
    result:
      'Selbstbedienung für den Auftraggeber: Angebote freigeben, Rechnungen bezahlen, Unterlagen abrufen, Termine sehen, eine Störung melden und die eigenen Anlagen mit ihren Prüfterminen sehen.',
  },
  {
    number: '6',
    title: 'Bilanz und Ausbau',
    state: 'planned',
    result:
      'Anlagenbuchhaltung, Bilanz und GuV, Auswertungen, Volltextsuche, eine offene Schnittstelle für Drittanbieter und weitere Gewerke als Erweiterungen auf derselben Formular- und Fristen-Engine.',
  },
];
---

<Page
  title="Stand und Fahrplan der Handwerkersoftware OpenGewerk"
  description="Wie weit die Handwerkersoftware OpenGewerk ist und was als Nächstes kommt: vom Fundament über den MVP im Pilotbetrieb bis zu Buchhaltung, Kanzlei-Anbindung und Kundenportal."
  breadcrumb="Stand"
>
  <section class="section section-dark">
    <div class="wrap measure stack">
      <h1>Wo die Handwerkersoftware im Oktober 2026 steht</h1>
      <p class="lead">
        OpenGewerk wird entlang eines Pilotbetriebs gebaut, eines Elektro- und
        PV-Unternehmens. Version 1 ist erreicht, wenn dessen Aufträge vollständig in
        OpenGewerk laufen. Alles, was sich später nicht nachrüsten lässt, kommt
        trotzdem zuerst: Datenmodell, Offline-Schicht, Festschreibung und
        Mandantentrennung.
      </p>
      <p>
        Wie weit OpenGewerk Haustechnik ist, die Anwendung für Betreiber von Gebäuden,
        steht auf <a href="/haustechnik/stand/">ihrer eigenen Seite</a>.
      </p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap stack-loose">
      <h2>Die Phasen</h2>
      <Phases phases={phases} />
    </div>
  </section>

  <section class="section">
    <div class="wrap measure stack-loose is-centered">
      <h2>Warum der Fahrplan hier steht und nicht als Versprechen</h2>
      <p>
        Es gibt kein Datum an diesen Phasen. Das Projekt entsteht neben einem laufenden
        Betrieb, und ein genanntes Datum wäre eine Zahl, die niemand einhält. Was es
        stattdessen gibt, ist Offenheit über den Stand: jede Aufgabe liegt als Issue
        auf GitHub, jede größere Entscheidung als Architekturentscheidung mit
        Begründung.
      </p>
      <p>
        Eine Regel dabei hat sich als wichtig erwiesen: die Liste der Issues ist nicht
        der Fortschritt, sie ist nur so vollständig wie der letzte Schnitt. Verbindlich
        ist der Fahrplan im Konzept, die Issues sind die Abschrift davon.
      </p>
      <div class="button-row">
        <a class="button button-primary" href={LINKS.repository + '/issues'} rel="noopener">
          Offene Aufgaben ansehen
        </a>
        <a class="button button-outline" href={LINKS.decisions} rel="noopener">
          Architekturentscheidungen
        </a>
      </div>
    </div>
  </section>
</Page>

